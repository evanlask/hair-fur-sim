# Editor directories and files
# .vscode/settings.json and extensions.json are committed. `!.vscode/` comes first in case a global gitignore
# excludes the directory: git won't look inside an ignored directory, so the negations below would do nothing.
!.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# macOS
.DS_Store
