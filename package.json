    "@types/three": "0.186.0",
    "@webgpu/types": "0.1.74",
    "typescript": "^7.0.0",
    "vite-plus": "1.1.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "engines": {
    "node": ">=24"
