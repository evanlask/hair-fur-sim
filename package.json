{
  "name": "hair-fur-sim",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time GPU strand hair and fur simulation with guide hairs, built on three.js WebGPU and TSL.",
  "keywords": [
    "fur",
    "hair",
    "simulation",
    "three.js",
    "tsl",
    "webgpu"
  ],
  "homepage": "https://evanlask.github.io/hair-fur-sim/",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evanlask/hair-fur-sim.git"
  },
  "type": "module",
  "scripts": {
    "build": "vp build",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "clean": "rm -rf .vite-hooks/_ *.log coverage dist node_modules",
    "dev": "vp dev",
    "prepare": "vp config",
    "preview": "vp preview",
    "test": "vp test --passWithNoTests",
    "test:watch": "vp test watch"
  },
  "dependencies": {
    "@tweakpane/plugin-essentials": "0.2.1",
    "three": "0.186.1",
    "tweakpane": "4.0.5"
